# Environment template for StockOps
# Copy to `.env` for local. Set the same keys as Fly secrets for production.

# From Partner Dashboard → Apps → StockOps → Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,read_inventory,write_inventory,read_orders,read_locations,write_locations

# Local (shopify app dev updates this). Production = your Fly URL, e.g. https://stockops.fly.dev
SHOPIFY_APP_URL=https://stockops.fly.dev

# 32-byte hex: openssl rand -hex 32
ENCRYPTION_KEY=

# Local Postgres (docker compose up -d):
DATABASE_URL=postgresql://stockops:stockops@localhost:5432/stockops
# Production: set by `fly postgres attach` as DATABASE_URL (do not put prod URL in git)

# Billing
# Dev: leave unset for test charges. Production on Fly: BILLING_TEST=0
# BILLING_TEST=0
# BILLING_ENFORCE=1

NODE_ENV=development
